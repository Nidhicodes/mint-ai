---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mint AI — Describe any app. Get it instantly." description="Your personal AI app store. Describe any app you want and get it instantly. 100% local, zero cost, infinite possibilities.">
  <main class="min-h-screen flex flex-col">

    <!-- Navigation — floating pill, Anything.com style -->
    <nav class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-2rem)] max-w-4xl">
      <div class="flex items-center justify-between h-14 px-5 sm:px-6 rounded-full border border-mint-500/[0.12]" style="backdrop-filter:blur(24px) saturate(1.4);-webkit-backdrop-filter:blur(24px) saturate(1.4);background:rgba(15,15,15,0.7);box-shadow:0 0 30px rgba(16,185,129,0.04),0 4px 20px rgba(0,0,0,0.3)">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <svg class="w-5 h-5 text-mint-400 transition-transform duration-700 group-hover:rotate-[20deg]" viewBox="0 0 32 32" fill="none">
            <path d="M16 4C10 8 6 14 6 20c0 4 2.5 7 6 8 1.5.4 3 .2 4-1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M16 4c6 4 10 10 10 16 0 4-2.5 7-6 8-1.5.4-3 .2-4-1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M16 4v23" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.4"/>
          </svg>
          <span class="text-[15px] font-semibold text-white tracking-tight">Mint AI</span>
        </a>
        <!-- Links + CTA -->
        <div class="flex items-center gap-1 sm:gap-5">
          <a href="#showcase" class="hidden sm:block text-[13px] text-white/55 hover:text-white transition-colors duration-200 px-2">Showcase</a>
          <a href="#how" class="hidden sm:block text-[13px] text-white/55 hover:text-white transition-colors duration-200 px-2">How it works</a>
          <a href="/app?new" class="text-[13px] font-semibold text-white bg-mint-500 hover:bg-mint-400 px-5 py-2 rounded-full active:scale-[0.97] transition-all duration-200 ml-1 sm:ml-2 shadow-lg shadow-mint-500/20">
            Get Started
          </a>
        </div>
      </div>
    </nav>

    <!-- HERO with Starry Night Over the Rhône — dark water, amber reflections -->
    <section id="hero-section" class="relative flex flex-col items-center justify-center text-center px-6 pt-40 sm:pt-52 pb-28 sm:pb-40 overflow-hidden min-h-screen" style="background:url('/art/rhone.jpg') center/cover no-repeat">
      <!-- Dark overlay — shaped to let the amber reflections glow through subtly -->
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(5,5,5,0.92) 0%,rgba(5,5,5,0.78) 25%,rgba(5,5,5,0.65) 50%,rgba(5,5,5,0.75) 75%,rgba(5,5,5,0.95) 100%)"></div>
      <!-- Animated orbs — Rhône palette: amber reflections, deep blue sky -->
      <div class="absolute w-[400px] h-[400px] rounded-full pointer-events-none" style="top:8%;left:12%;background:rgba(245,158,11,0.05);filter:blur(120px);animation:orb-drift 10s ease-in-out infinite" aria-hidden="true"></div>
      <div class="absolute w-[350px] h-[350px] rounded-full pointer-events-none" style="top:35%;right:8%;background:rgba(37,99,235,0.04);filter:blur(100px);animation:orb-drift 12s ease-in-out infinite 3s" aria-hidden="true"></div>
      <div class="absolute w-[300px] h-[300px] rounded-full pointer-events-none" style="bottom:15%;left:25%;background:rgba(245,158,11,0.035);filter:blur(110px);animation:orb-drift 10s ease-in-out infinite 6s" aria-hidden="true"></div>
      <!-- Brushstrokes — warm palette matching Rhône -->
      <div class="absolute pointer-events-none" style="width:120px;height:3px;top:18%;left:6%;border-radius:100px;background:linear-gradient(90deg,rgba(245,158,11,0.3),transparent);transform:rotate(-12deg);animation:brushfloat 8s ease-in-out infinite" aria-hidden="true"></div>
      <div class="absolute pointer-events-none" style="width:90px;height:2px;top:28%;right:10%;border-radius:100px;background:linear-gradient(90deg,rgba(59,130,246,0.2),transparent);transform:rotate(18deg);animation:brushfloat 9s ease-in-out infinite 2s" aria-hidden="true"></div>
      <div class="absolute pointer-events-none" style="width:70px;height:2px;bottom:35%;left:18%;border-radius:100px;background:linear-gradient(90deg,rgba(251,191,36,0.2),transparent);transform:rotate(-6deg);animation:brushfloat 7s ease-in-out infinite 4s" aria-hidden="true"></div>
      <div class="absolute pointer-events-none" style="width:100px;height:2.5px;bottom:25%;right:15%;border-radius:100px;background:linear-gradient(90deg,rgba(59,130,246,0.15),transparent);transform:rotate(10deg);animation:brushfloat 10s ease-in-out infinite 1s" aria-hidden="true"></div>

      <!-- Content -->
      <div class="relative z-10">
        <p class="text-[11px] sm:text-xs tracking-[0.3em] uppercase text-white/50 mb-8 font-medium hero-anim" style="--i:0">Your personal app store</p>
        <h1>
          <span class="block font-display text-5xl sm:text-7xl md:text-8xl lg:text-[7rem] text-white leading-[0.95] tracking-tight hero-anim" style="--i:1">Describe any app.</span>
          <!-- OPTIONS for "Get it instantly" color — currently showing Option A (white-to-silver) -->
          <!-- Option A: White-to-silver gradient — clean, elegant, lets the italic do the work -->
          <!-- Option B: Soft lavender-to-white — #c4b5fd → #e9d5ff → #fff — dreamy, artistic -->
          <!-- Option C: Warm cream-to-white — #fef3c7 → #fde68a → #fff — warm, inviting -->
          <span class="block font-display italic text-5xl sm:text-7xl md:text-8xl lg:text-[7rem] leading-[0.95] tracking-tight mt-2 hero-anim" style="--i:2;background:linear-gradient(135deg,#ffffff,#d4d4d8,#a1a1aa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Get it instantly.</span>
        </h1>
        <p class="text-base sm:text-lg text-white/60 max-w-md mx-auto mt-10 mb-16 leading-relaxed font-light hero-anim" style="--i:3">AI generates complete, working web apps from a single sentence. Everything runs locally in your browser.</p>
        <div class="w-full max-w-2xl mx-auto hero-anim" style="--i:4">
          <form id="hero-prompt-form" class="relative group">
            <div class="absolute -inset-px rounded-2xl bg-gradient-to-r from-blue-500/20 via-mint-500/25 to-amber-500/20 opacity-0 group-focus-within:opacity-100 transition-opacity duration-700 blur-sm"></div>
            <div class="relative rounded-2xl border border-white/[0.12] bg-black/40 backdrop-blur-xl shadow-2xl shadow-black/30 group-focus-within:border-white/[0.2] transition-all duration-500">
              <div class="flex items-center gap-3 px-5 sm:px-6 py-4 sm:py-5">
                <input id="hero-prompt-input" type="text" class="flex-1 bg-transparent text-base sm:text-lg text-white placeholder-white/35 outline-none font-light" placeholder="A pomodoro timer with ambient sounds..." autocomplete="off" />
                <button type="submit" class="bg-white text-black font-medium text-sm px-6 py-2.5 rounded-full hover:bg-white/90 active:scale-[0.97] transition-all duration-200 shrink-0 shadow-lg shadow-white/5">Create</button>
              </div>
            </div>
          </form>
          <p class="text-center text-[11px] text-white/30 mt-5 tracking-wide">No server · No API key · No cost · Runs in your browser</p>
        </div>
      </div>
      <!-- Scroll cue -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10" style="animation:scrollpulse 3s ease-in-out infinite" aria-hidden="true">
        <div class="w-5 h-8 rounded-full border border-white/10 flex items-start justify-center pt-1.5">
          <div class="w-0.5 h-2 rounded-full bg-white/30" style="animation:scrolldot 2s ease-in-out infinite"></div>
        </div>
      </div>
    </section>

    <!-- SHOWCASE with Almond Blossom corner -->
    <section id="showcase" class="relative px-6 sm:px-10 py-28 sm:py-36 max-w-7xl mx-auto w-full overflow-hidden">
      <div class="absolute -top-16 -right-16 w-[450px] h-[450px] opacity-[0.06] pointer-events-none rounded-3xl" style="transform:rotate(8deg);background:url('/art/almond-blossom.jpg') center/cover;animation:artfloat 12s ease-in-out infinite" aria-hidden="true"></div>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-16 reveal">
        <div>
          <p class="text-[11px] tracking-[0.3em] uppercase text-white/40 mb-4 font-medium">Showcase</p>
          <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-white leading-tight">See what people<br class="hidden sm:block" /> are building</h2>
        </div>
        <p class="text-sm text-white/50 max-w-xs mt-4 sm:mt-0 leading-relaxed font-light">Real apps, running live. Every one was generated from a single prompt.</p>
      </div>
      <div id="showcase-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger"></div>
    </section>

    <!-- ═══ LIVE DEMO — Terminal + Preview ═══ -->
    <section class="px-6 sm:px-10 py-24 sm:py-32 max-w-5xl mx-auto w-full reveal">
      <div class="text-center mb-12">
        <p class="text-[11px] tracking-[0.3em] uppercase text-white/40 mb-4 font-medium">See it in action</p>
        <h2 class="font-display text-3xl sm:text-4xl text-white">From prompt to app in seconds</h2>
      </div>

      <!-- Terminal window -->
      <div class="rounded-2xl border border-white/[0.06] overflow-hidden" style="background:rgba(10,10,10,0.8)">
        <!-- Title bar -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/[0.04]">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
          </div>
          <span class="text-[11px] text-white/25 font-mono ml-2">mint-ai</span>
        </div>

        <!-- Split: terminal left, preview right -->
        <div class="flex flex-col sm:flex-row min-h-[340px]">
          <!-- Terminal side -->
          <div class="sm:w-[45%] p-5 border-b sm:border-b-0 sm:border-r border-white/[0.04] font-mono text-[13px] leading-relaxed">
            <!-- Prompt line -->
            <div class="flex items-center gap-2 mb-4">
              <span class="text-mint-400">→</span>
              <span class="text-white/70" id="demo-prompt"></span>
              <span class="w-[2px] h-4 bg-mint-400 inline-block" id="demo-cursor" style="animation:blink 1s step-end infinite"></span>
            </div>
            <!-- Streaming code -->
            <div class="text-white/30 overflow-hidden" id="demo-code" style="max-height:260px"></div>
          </div>

          <!-- Preview side -->
          <div class="sm:w-[55%] bg-white/[0.02] flex items-center justify-center p-6 relative">
            <div id="demo-preview" class="w-full max-w-[280px] opacity-0 transition-all duration-700" style="transform:translateY(12px)">
              <!-- Mini app mockup -->
              <div class="rounded-xl border border-white/[0.06] overflow-hidden" style="background:rgba(15,15,15,0.9)">
                <div class="px-4 py-3 border-b border-white/[0.04]">
                  <div class="w-20 h-2 rounded bg-white/10 mb-2"></div>
                  <div class="w-32 h-1.5 rounded bg-white/[0.05]"></div>
                </div>
                <div class="p-4 space-y-3">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-mint-500/20 flex items-center justify-center"><span class="text-xs">🎯</span></div>
                    <div class="flex-1"><div class="w-24 h-2 rounded bg-white/10 mb-1.5"></div><div class="w-16 h-1.5 rounded bg-white/[0.05]"></div></div>
                    <div class="w-10 h-5 rounded-full bg-mint-500/30"></div>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center"><span class="text-xs">📊</span></div>
                    <div class="flex-1"><div class="w-20 h-2 rounded bg-white/10 mb-1.5"></div><div class="w-28 h-1.5 rounded bg-white/[0.05]"></div></div>
                    <div class="w-10 h-5 rounded-full bg-white/[0.06]"></div>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-amber-500/20 flex items-center justify-center"><span class="text-xs">⏱</span></div>
                    <div class="flex-1"><div class="w-28 h-2 rounded bg-white/10 mb-1.5"></div><div class="w-12 h-1.5 rounded bg-white/[0.05]"></div></div>
                    <div class="w-10 h-5 rounded-full bg-mint-500/30"></div>
                  </div>
                  <div class="mt-3 h-1.5 rounded-full bg-white/[0.04] overflow-hidden"><div class="h-full w-[65%] rounded-full bg-mint-500/40"></div></div>
                </div>
              </div>
              <p class="text-[10px] text-white/30 text-center mt-3 font-mono">habit-tracker.html</p>
            </div>
            <!-- Loading state -->
            <div id="demo-loading" class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <div class="w-6 h-6 border border-white/10 border-t-mint-400/50 rounded-full mx-auto mb-3" style="animation:spin 1s linear infinite"></div>
                <p class="text-[11px] text-white/25 font-mono">Generating...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="px-6 sm:px-10 py-28 sm:py-36 max-w-7xl mx-auto w-full">
      <div class="text-center mb-20 reveal">
        <p class="text-[11px] tracking-[0.3em] uppercase text-white/40 mb-4 font-medium">Process</p>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-white">Three steps. That's it.</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-16 sm:gap-10 reveal-stagger">
        <div class="text-center sm:text-left group" style="transition:transform 0.5s cubic-bezier(0.34,1.56,0.64,1)">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full border border-white/[0.06] bg-white/[0.02] mb-6 group-hover:border-blue-500/20 group-hover:bg-blue-500/[0.04] transition-all duration-500">
            <span class="text-base font-display italic text-white/40 group-hover:text-blue-400/70 transition-colors duration-500">1</span>
          </div>
          <h3 class="text-lg font-medium text-white mb-3 tracking-tight">Describe</h3>
          <p class="text-sm text-white/50 leading-relaxed font-light">Type what you want in plain English. A budget tracker, a quiz app, a recipe scaler — anything.</p>
        </div>
        <div class="text-center sm:text-left group" style="transition:transform 0.5s cubic-bezier(0.34,1.56,0.64,1)">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full border border-white/[0.06] bg-white/[0.02] mb-6 group-hover:border-mint-500/20 group-hover:bg-mint-500/[0.04] transition-all duration-500">
            <span class="text-base font-display italic text-white/40 group-hover:text-mint-400/70 transition-colors duration-500">2</span>
          </div>
          <h3 class="text-lg font-medium text-white mb-3 tracking-tight">Generate</h3>
          <p class="text-sm text-white/50 leading-relaxed font-light">AI writes the code and builds a complete, working app in seconds. Watch it come to life in real time.</p>
        </div>
        <div class="text-center sm:text-left group" style="transition:transform 0.5s cubic-bezier(0.34,1.56,0.64,1)">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full border border-white/[0.06] bg-white/[0.02] mb-6 group-hover:border-amber-500/20 group-hover:bg-amber-500/[0.04] transition-all duration-500">
            <span class="text-base font-display italic text-white/40 group-hover:text-amber-400/70 transition-colors duration-500">3</span>
          </div>
          <h3 class="text-lg font-medium text-white mb-3 tracking-tight">Use & share</h3>
          <p class="text-sm text-white/50 leading-relaxed font-light">Iterate with follow-up prompts. Export as HTML, share via link, or fork from the gallery.</p>
        </div>
      </div>
    </section>

    <!-- ═══ WHAT WILL YOU BUILD — Prompt Carousel ═══ -->
    <section class="px-6 sm:px-10 py-24 sm:py-32 overflow-hidden reveal">
      <div class="max-w-5xl mx-auto text-center mb-14">
        <p class="text-[11px] tracking-[0.3em] uppercase text-white/40 mb-4 font-medium">Possibilities</p>
        <h2 class="font-display text-3xl sm:text-4xl text-white">What will you build?</h2>
      </div>

      <!-- Scrolling prompt cards -->
      <div class="relative">
        <div class="flex gap-4 prompt-scroll" id="prompt-carousel">
          <div class="prompt-card shrink-0 w-[280px] rounded-2xl border border-white/[0.06] p-5" style="background:rgba(10,10,10,0.6)">
            <div class="flex items-center gap-2 mb-3"><span class="text-lg">🎵</span><span class="text-xs text-white/40 font-mono">music-player.html</span></div>
            <p class="text-sm text-white/70 mb-4 font-light">"A Spotify-style music player with playlists and visualizer"</p>
            <div class="flex gap-1.5"><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">entertainment</span><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">audio</span></div>
          </div>
          <div class="prompt-card shrink-0 w-[280px] rounded-2xl border border-white/[0.06] p-5" style="background:rgba(10,10,10,0.6)">
            <div class="flex items-center gap-2 mb-3"><span class="text-lg">💰</span><span class="text-xs text-white/40 font-mono">budget-app.html</span></div>
            <p class="text-sm text-white/70 mb-4 font-light">"A budget tracker with pie charts and monthly trends"</p>
            <div class="flex gap-1.5"><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">finance</span><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">charts</span></div>
          </div>
          <div class="prompt-card shrink-0 w-[280px] rounded-2xl border border-white/[0.06] p-5" style="background:rgba(10,10,10,0.6)">
            <div class="flex items-center gap-2 mb-3"><span class="text-lg">🧠</span><span class="text-xs text-white/40 font-mono">flashcards.html</span></div>
            <p class="text-sm text-white/70 mb-4 font-light">"A flashcard quiz with spaced repetition and streaks"</p>
            <div class="flex gap-1.5"><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">education</span><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">quiz</span></div>
          </div>
          <div class="prompt-card shrink-0 w-[280px] rounded-2xl border border-white/[0.06] p-5" style="background:rgba(10,10,10,0.6)">
            <div class="flex items-center gap-2 mb-3"><span class="text-lg">🏋️</span><span class="text-xs text-white/40 font-mono">workout-log.html</span></div>
            <p class="text-sm text-white/70 mb-4 font-light">"A workout tracker with body diagram and PR history"</p>
            <div class="flex gap-1.5"><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">health</span><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">fitness</span></div>
          </div>
          <div class="prompt-card shrink-0 w-[280px] rounded-2xl border border-white/[0.06] p-5" style="background:rgba(10,10,10,0.6)">
            <div class="flex items-center gap-2 mb-3"><span class="text-lg">🍳</span><span class="text-xs text-white/40 font-mono">recipe-scaler.html</span></div>
            <p class="text-sm text-white/70 mb-4 font-light">"A recipe scaler that adjusts ingredients for any serving size"</p>
            <div class="flex gap-1.5"><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">utility</span><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">cooking</span></div>
          </div>
          <div class="prompt-card shrink-0 w-[280px] rounded-2xl border border-white/[0.06] p-5" style="background:rgba(10,10,10,0.6)">
            <div class="flex items-center gap-2 mb-3"><span class="text-lg">📝</span><span class="text-xs text-white/40 font-mono">journal.html</span></div>
            <p class="text-sm text-white/70 mb-4 font-light">"A daily journal with mood tracking and word count goals"</p>
            <div class="flex gap-1.5"><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">productivity</span><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">writing</span></div>
          </div>
          <div class="prompt-card shrink-0 w-[280px] rounded-2xl border border-white/[0.06] p-5" style="background:rgba(10,10,10,0.6)">
            <div class="flex items-center gap-2 mb-3"><span class="text-lg">🎨</span><span class="text-xs text-white/40 font-mono">color-palette.html</span></div>
            <p class="text-sm text-white/70 mb-4 font-light">"A color palette generator with harmony rules and export"</p>
            <div class="flex gap-1.5"><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">creative</span><span class="text-[9px] px-2 py-0.5 rounded-full border border-white/[0.06] text-white/30">design</span></div>
          </div>
        </div>
        <!-- Fade edges -->
        <div class="absolute inset-y-0 left-0 w-20 pointer-events-none" style="background:linear-gradient(to right,#050505,transparent)"></div>
        <div class="absolute inset-y-0 right-0 w-20 pointer-events-none" style="background:linear-gradient(to left,#050505,transparent)"></div>
      </div>
    </section>

    <!-- STATS with Wheat Field background -->
    <section class="relative px-6 sm:px-10 py-28 sm:py-36 overflow-hidden reveal" style="background:url('/art/wheat-field.jpg') center/cover no-repeat">
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(5,5,5,0.88),rgba(5,5,5,0.7),rgba(5,5,5,0.88))"></div>
      <div class="max-w-5xl mx-auto relative z-10">
        <div class="text-center mb-16"><h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-white">Completely yours.</h2></div>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-14 sm:gap-24">
          <div class="text-center stat-el" style="--d:0s"><p class="font-display text-5xl sm:text-7xl" style="background:linear-gradient(180deg,#fff,rgba(255,255,255,0.5));-webkit-background-clip:text;-webkit-text-fill-color:transparent">100%</p><p class="text-[11px] text-white/40 mt-3 tracking-[0.2em] uppercase font-medium">On your device</p></div>
          <div class="hidden sm:block w-px h-20 bg-gradient-to-b from-transparent via-white/[0.06] to-transparent" aria-hidden="true"></div>
          <div class="text-center stat-el" style="--d:0.15s"><p class="font-display text-5xl sm:text-7xl" style="background:linear-gradient(180deg,#fff,rgba(255,255,255,0.5));-webkit-background-clip:text;-webkit-text-fill-color:transparent">$0</p><p class="text-[11px] text-white/40 mt-3 tracking-[0.2em] uppercase font-medium">Free forever</p></div>
          <div class="hidden sm:block w-px h-20 bg-gradient-to-b from-transparent via-white/[0.06] to-transparent" aria-hidden="true"></div>
          <div class="text-center stat-el" style="--d:0.3s"><p class="font-display text-5xl sm:text-7xl" style="background:linear-gradient(180deg,#fff,rgba(255,255,255,0.5));-webkit-background-clip:text;-webkit-text-fill-color:transparent">&infin;</p><p class="text-[11px] text-white/40 mt-3 tracking-[0.2em] uppercase font-medium">Unlimited apps</p></div>
        </div>
      </div>
    </section>

    <!-- CTA with Starry Night -->
    <section class="relative px-6 sm:px-10 py-32 sm:py-48 text-center overflow-hidden reveal" style="background:url('/art/starry-night.jpg') center/cover no-repeat">
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(5,5,5,0.85),rgba(5,5,5,0.55),rgba(5,5,5,0.85))"></div>
      <div class="absolute w-[300px] h-[300px] rounded-full pointer-events-none" style="top:30%;left:40%;background:rgba(245,158,11,0.04);filter:blur(100px);animation:orb-drift 10s ease-in-out infinite" aria-hidden="true"></div>
      <div class="relative z-10">
        <p class="text-xs tracking-[0.3em] uppercase text-white/50 mb-6 font-medium">Ready?</p>
        <h2 class="font-display italic text-4xl sm:text-5xl md:text-7xl text-white mb-6">Start creating.</h2>
        <p class="text-[15px] text-white/70 mb-12 font-light max-w-sm mx-auto leading-relaxed">No sign-up. No setup. Just describe what you want.</p>
        <a href="/app?new" class="cta-btn inline-flex items-center gap-3 px-10 py-4 rounded-full text-[15px] font-medium bg-white text-black transition-all duration-300 hover:scale-[1.03] active:scale-[0.98]" style="box-shadow:0 0 40px rgba(255,255,255,0.06),0 0 80px rgba(255,255,255,0.03)">
          Open Mint AI
          <svg class="w-4 h-4 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <p class="text-[9px] text-white/[0.06] mt-16">Art: Vincent van Gogh, public domain via Wikimedia Commons</p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="px-6 sm:px-10 py-10 border-t border-white/[0.06]">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <svg class="w-4 h-4 text-white/60" viewBox="0 0 32 32" fill="none"><path d="M16 4C10 8 6 14 6 20c0 4 2.5 7 6 8 1.5.4 3 .2 4-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M16 4c6 4 10 10 10 16 0 4-2.5 7-6 8-1.5.4-3 .2-4-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M16 4v23" stroke="currentColor" stroke-width="1" stroke-linecap="round" opacity="0.4"/></svg>
          <span class="text-xs text-white/60">Mint AI</span>
        </div>
        <p class="text-[11px] text-white/45 tracking-wide">Built for your browser. Runs on your device.</p>
      </div>
    </footer>
  </main>

  <style>
    .hero-anim { opacity:0; transform:translateY(30px) scale(0.98); animation:spring-in 1.2s cubic-bezier(0.34,1.56,0.64,1) forwards; animation-delay:calc(0.2s + var(--i,0) * 0.13s); }
    @keyframes spring-in { 0%{opacity:0;transform:translateY(30px) scale(0.98)} 60%{opacity:1;transform:translateY(-4px) scale(1.005)} 80%{transform:translateY(2px) scale(0.998)} 100%{opacity:1;transform:translateY(0) scale(1)} }
    @keyframes orb-drift { 0%,100%{transform:translate(0,0) scale(1)} 25%{transform:translate(20px,-15px) scale(1.05)} 50%{transform:translate(-10px,20px) scale(0.95)} 75%{transform:translate(15px,10px) scale(1.02)} }
    @keyframes brushfloat { 0%,100%{transform:translateY(0) rotate(var(--r,0deg))} 50%{transform:translateY(-8px) rotate(var(--r,0deg))} }
    @keyframes scrollpulse { 0%,100%{opacity:0.3} 50%{opacity:0.8} }
    @keyframes scrolldot { 0%{transform:translateY(0);opacity:1} 100%{transform:translateY(8px);opacity:0} }
    @keyframes artfloat { 0%,100%{transform:rotate(8deg) translate(0,0)} 50%{transform:rotate(10deg) translate(-5px,8px)} }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
    @keyframes spin { to{transform:rotate(360deg)} }
    /* Prompt carousel auto-scroll */
    .prompt-scroll { animation:carousel-scroll 30s linear infinite; }
    .prompt-scroll:hover { animation-play-state:paused; }
    @keyframes carousel-scroll { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
    .prompt-card { transition:all 0.3s ease; }
    .prompt-card:hover { border-color:rgba(255,255,255,0.12); transform:translateY(-2px); }
    .stat-el { opacity:0; transform:translateY(24px) scale(0.95); transition:all 0.9s cubic-bezier(0.34,1.56,0.64,1); transition-delay:var(--d,0s); }
    .revealed .stat-el, .reveal.revealed .stat-el { opacity:1; transform:translateY(0) scale(1); }
    .cta-btn { position:relative; overflow:hidden; }
    .cta-btn::before { content:''; position:absolute; inset:0; background:linear-gradient(90deg,transparent,rgba(255,255,255,0.1),transparent); transform:translateX(-100%); transition:transform 0.6s ease; }
    .cta-btn:hover::before { transform:translateX(100%); }
    .cta-btn:hover { box-shadow:0 0 60px rgba(255,255,255,0.12),0 0 120px rgba(255,255,255,0.06) !important; }
    @media (prefers-reduced-motion:reduce) { .hero-anim{opacity:1;transform:none;animation:none} .stat-el{opacity:1;transform:none;transition:none} }
  </style>

  <script>
    (function(){const h=window.location.hash;if(h&&h.startsWith('#app=')){window.location.replace('/share'+h);return}})();
    const phs=['A pomodoro timer with ambient sounds...','A budget tracker with spending charts...','A flashcard app for studying...','A workout log with progress tracking...','A recipe scaler for dinner parties...','A habit tracker with daily streaks...'];
    let pi=0;const inp=document.getElementById('hero-prompt-input') as HTMLInputElement;
    function rp(){if(!inp||document.activeElement===inp)return;pi=(pi+1)%phs.length;inp.style.transition='opacity 0.4s ease';inp.style.opacity='0';setTimeout(()=>{inp.placeholder=phs[pi];inp.style.opacity='1'},400)}
    setInterval(rp,4000);
    document.getElementById('hero-prompt-form')?.addEventListener('submit',(e)=>{e.preventDefault();const v=inp?.value.trim();if(v)window.location.href='/app?prompt='+encodeURIComponent(v)});
    // Mouse parallax on orbs
    if(!window.matchMedia('(prefers-reduced-motion:reduce)').matches){
      let mx=0,my=0,cx=0,cy=0;
      const orbs=document.querySelectorAll('[style*="orb-drift"]');
      document.addEventListener('mousemove',(e)=>{mx=(e.clientX/window.innerWidth-0.5)*2;my=(e.clientY/window.innerHeight-0.5)*2});
      function ao(){cx+=(mx-cx)*0.03;cy+=(my-cy)*0.03;orbs.forEach((el,i)=>{const s=6+(i%3)*4;(el as HTMLElement).style.marginLeft=cx*s+'px';(el as HTMLElement).style.marginTop=cy*s+'px'});requestAnimationFrame(ao)}
      ao();
    }
    // Gallery
    async function ls(){try{const r=await fetch('/gallery.json');const d=await r.json();const a=d.apps.slice(0,6);const g=document.getElementById('showcase-grid');if(!g)return;a.forEach((app:any)=>{const c=document.createElement('div');c.className='group rounded-2xl overflow-hidden border border-white/[0.04] bg-white/[0.01] hover:border-white/[0.1] hover:bg-white/[0.02] transition-all duration-500 hover:scale-[1.015] hover:shadow-2xl hover:shadow-black/30';const b=new Blob([app.html],{type:'text/html'});const u=URL.createObjectURL(b);c.innerHTML=`<div class="relative w-full h-[280px] bg-zinc-950 overflow-hidden"><iframe src="${u}" sandbox="allow-scripts allow-same-origin" class="w-full h-full border-0 pointer-events-none" title="${app.title} preview" loading="lazy"></iframe></div><div class="p-5"><h3 class="text-[15px] font-medium text-white mb-1.5 tracking-tight group-hover:text-mint-400 transition-colors duration-300">${app.title}</h3><p class="text-xs text-white/50 line-clamp-2 mb-4 font-light leading-relaxed">${app.description}</p><div class="flex items-center justify-between"><div class="flex gap-1.5">${app.tags.slice(0,2).map((t:string)=>`<span class="text-[10px] px-2.5 py-1 rounded-full border border-white/[0.08] text-white/45">${t}</span>`).join('')}</div><a href="/app?fork=${app.id}" class="text-xs text-white/50 hover:text-white/90 transition-colors font-medium">Fork &rarr;</a></div></div>`;g.appendChild(c)})}catch(e){}}
    ls();
    // Scroll reveal
    if(typeof IntersectionObserver!=='undefined'){const o=new IntersectionObserver((es)=>{es.forEach((e)=>{if(e.isIntersecting){e.target.classList.add('revealed');o.unobserve(e.target)}})},{threshold:0.08,rootMargin:'0px 0px -60px 0px'});document.querySelectorAll('.reveal,.reveal-stagger').forEach((el)=>o.observe(el))}

    // Terminal demo typewriter
    (function initTerminalDemo(){
      const promptEl=document.getElementById('demo-prompt');
      const cursorEl=document.getElementById('demo-cursor');
      const codeEl=document.getElementById('demo-code');
      const previewEl=document.getElementById('demo-preview');
      const loadingEl=document.getElementById('demo-loading');
      if(!promptEl||!codeEl||!previewEl||!loadingEl) return;

      const promptText='A habit tracker with daily streaks and progress bars';
      const codeLines=[
        '<span class="text-white/20">&lt;!</span><span class="text-blue-400/60">DOCTYPE html</span><span class="text-white/20">&gt;</span>',
        '<span class="text-white/20">&lt;</span><span class="text-blue-400/60">html</span> <span class="text-amber-400/50">data-theme</span><span class="text-white/20">=</span><span class="text-mint-400/60">"night"</span><span class="text-white/20">&gt;</span>',
        '<span class="text-white/20">&lt;</span><span class="text-blue-400/60">head</span><span class="text-white/20">&gt;</span>',
        '  <span class="text-white/20">&lt;</span><span class="text-blue-400/60">title</span><span class="text-white/20">&gt;</span><span class="text-white/40">Habit Tracker</span><span class="text-white/20">&lt;/</span><span class="text-blue-400/60">title</span><span class="text-white/20">&gt;</span>',
        '  <span class="text-white/20">&lt;</span><span class="text-blue-400/60">script</span> <span class="text-amber-400/50">src</span><span class="text-white/20">=</span><span class="text-mint-400/60">"tailwindcss"</span><span class="text-white/20">&gt;&lt;/</span><span class="text-blue-400/60">script</span><span class="text-white/20">&gt;</span>',
        '<span class="text-white/20">&lt;/</span><span class="text-blue-400/60">head</span><span class="text-white/20">&gt;</span>',
        '<span class="text-white/20">&lt;</span><span class="text-blue-400/60">body</span> <span class="text-amber-400/50">class</span><span class="text-white/20">=</span><span class="text-mint-400/60">"min-h-screen bg-base-100"</span><span class="text-white/20">&gt;</span>',
        '  <span class="text-white/20">&lt;</span><span class="text-blue-400/60">div</span> <span class="text-amber-400/50">class</span><span class="text-white/20">=</span><span class="text-mint-400/60">"container mx-auto"</span><span class="text-white/20">&gt;</span>',
        '    <span class="text-white/15">// habits array, streak logic...</span>',
        '    <span class="text-white/20">&lt;</span><span class="text-blue-400/60">header</span><span class="text-white/20">&gt;</span><span class="text-white/40">Daily Habits</span><span class="text-white/20">&lt;/</span><span class="text-blue-400/60">header</span><span class="text-white/20">&gt;</span>',
        '    <span class="text-white/15">// progress bars, toggles...</span>',
        '  <span class="text-white/20">&lt;/</span><span class="text-blue-400/60">div</span><span class="text-white/20">&gt;</span>',
        '<span class="text-white/20">&lt;/</span><span class="text-blue-400/60">body</span><span class="text-white/20">&gt;&lt;/</span><span class="text-blue-400/60">html</span><span class="text-white/20">&gt;</span>',
      ];

      let started=false;
      function runDemo(){
        if(started) return;
        started=true;
        promptEl.textContent='';
        codeEl.innerHTML='';
        loadingEl.style.display='flex';
        previewEl.style.opacity='0';
        previewEl.style.transform='translateY(12px)';

        // Type prompt
        let ci=0;
        function typePrompt(){
          if(ci<promptText.length){
            promptEl.textContent+=promptText[ci];
            ci++;
            setTimeout(typePrompt,30+Math.random()*40);
          } else {
            if(cursorEl) cursorEl.style.display='none';
            setTimeout(streamCode,500);
          }
        }

        // Stream code lines
        let li=0;
        function streamCode(){
          loadingEl.style.display='flex';
          function addLine(){
            if(li<codeLines.length){
              const line=document.createElement('div');
              line.innerHTML=codeLines[li];
              line.style.opacity='0';
              line.style.transform='translateY(4px)';
              codeEl.appendChild(line);
              requestAnimationFrame(()=>{line.style.transition='all 0.3s ease';line.style.opacity='1';line.style.transform='translateY(0)'});
              li++;
              setTimeout(addLine,150+Math.random()*200);
            } else {
              setTimeout(showPreview,600);
            }
          }
          addLine();
        }

        // Show preview
        function showPreview(){
          loadingEl.style.display='none';
          previewEl.style.opacity='1';
          previewEl.style.transform='translateY(0)';
          // Reset after 8s
          setTimeout(()=>{started=false;},8000);
        }

        typePrompt();
      }

      // Trigger when section scrolls into view
      const demoObs=new IntersectionObserver((entries)=>{
        entries.forEach(e=>{if(e.isIntersecting) runDemo()});
      },{threshold:0.3});
      const demoSection=promptEl.closest('section');
      if(demoSection) demoObs.observe(demoSection);
    })();

    // Duplicate carousel items for infinite scroll
    (function(){
      const carousel=document.getElementById('prompt-carousel');
      if(!carousel) return;
      const items=carousel.innerHTML;
      carousel.innerHTML=items+items;
    })();
  </script>
</Layout>
